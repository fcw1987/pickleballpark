{
  "name": "pickleboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Development checks for the Pickleboard static application and optional Three.js playback mode",
  "scripts": {
    "start": "node tests/helpers/static-server.mjs",
    "check": "node --check script.js && node --check sw.js && node --check guided-plays.js && node --check three-d-playback.js && node --test tests/*.unit.mjs && node tests/helpers/validate-static-assets.mjs && node tools/check-brand.mjs",
    "check:brand": "node tools/check-brand.mjs",
    "verify:rebrand-upgrade": "npm run build:site && node tools/verify-rebrand-upgrade.mjs",
    "test": "npm run check && playwright test",
    "test:browser": "playwright test",
    "test:headed": "playwright test --headed",
    "check:generated": "node tools/check-generated.mjs",
    "stamp:build": "node tools/stamp-build.mjs",
    "build:site": "node tools/build-site.mjs",
    "pin:local-candidate": "node tools/pin-local-candidate.mjs",
    "verify:deployment-artifact": "node tools/verify-deployment-artifact.mjs",
    "verify:package": "node tools/verify-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
